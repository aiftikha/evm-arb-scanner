# Copy to .env and replace only the endpoints you need.
# Never commit .env. Provider URLs can contain API keys.
RUST_LOG=info

ARBITRUM_RPC_URL=https://YOUR_ARBITRUM_RPC_ENDPOINT
BASE_RPC_URL=https://YOUR_BASE_RPC_ENDPOINT
OPTIMISM_RPC_URL=https://YOUR_OPTIMISM_RPC_ENDPOINT

# Optional: these chains are disabled by default in config.toml.
SCROLL_RPC_URL=https://YOUR_SCROLL_RPC_ENDPOINT
LINEA_RPC_URL=https://YOUR_LINEA_RPC_ENDPOINT
ZKSYNC_RPC_URL=https://YOUR_ZKSYNC_RPC_ENDPOINT
